import { Component, OnInit } from '@angular/core';
import { TarifasService, TiposVehiculoService, EstacionesService, Tarifa, TipoVehiculo, Estacion, PaginatedResponse } from '@toll-suite/data-access';

@Component({
  selector: 'app-tarifas',
  templateUrl: './tarifas.component.html',
  styleUrls: ['./tarifas.component.scss']
})
export class TarifasComponent implements OnInit {
  // Data properties
  tarifas: Tarifa[] = [];
  tiposVehiculo: TipoVehiculo[] = [];
  estaciones: Estacion[] = [];
  pagedTarifas: Tarifa[] = [];
  
  // State properties
  loading = false;
  showTarifaForm = false;
  showDeleteDialog = false;
  showViewDialog = false;
  isSubmittingForm = false;
  
  // Selected items
  selectedTarifa: Tarifa | null = null;
  tarifaToDelete: Tarifa | null = null;
  
  // Search and filter
  searchTerm = '';
  selectedTipoVehiculo = '';
  selectedEstacion = '';
  vigenciaFilter = 'todas';
  
  // Pagination
  currentPage = 1;
  pageSize = 10;
  totalTarifas = 0;
  totalPages = 0;
  
  // Sorting
  sortField = '';
  sortDirection: 'asc' | 'desc' = 'asc';

  constructor(
    private tarifasService: TarifasService,
    private tiposVehiculoService: TiposVehiculoService,
    private estacionesService: EstacionesService
  ) {}

  ngOnInit() {
    console.log('TarifasComponent initialized');
    this.loading = true;
    
    // Cargar tipos de vehículo y estaciones
    this.loadTiposVehiculo();
    this.loadEstaciones();
    
    // Cargar tarifas
    this.loadTarifas();
  }

  loadTarifas() {
    console.log('Attempting to load tarifas from API...');
    
    this.tarifasService.getAll().subscribe({
      next: (response: PaginatedResponse<Tarifa> | Tarifa[]) => {
        console.log('API response for tarifas:', response);
        
        // Handle both paginated and direct array responses
        let apiTarifas: Tarifa[] = [];
        if (Array.isArray(response)) {
          apiTarifas = response;
        } else if (response && response.data) {
          apiTarifas = response.data || [];
        }
        
        console.log('Loading API data:', apiTarifas.length, 'records');
        this.tarifas = apiTarifas;
        this.totalTarifas = apiTarifas.length;
        this.filterAndPaginateTarifas();
        this.loading = false;
      },
      error: (error: any) => {
        console.warn('API not available:', error);
        this.tarifas = [];
        this.totalTarifas = 0;
        this.loading = false;
        this.filterAndPaginateTarifas();
      }
    });
  }

  loadTiposVehiculo() {
    console.log('Loading tipos de vehículo...');
    this.tiposVehiculoService.getAll().subscribe({
      next: (response: PaginatedResponse<TipoVehiculo> | TipoVehiculo[]) => {
        // Handle both paginated and direct array responses
        if (Array.isArray(response)) {
          this.tiposVehiculo = response;
        } else if (response && response.data) {
          this.tiposVehiculo = response.data;
        } else {
          console.warn('Unexpected response format:', response);
          this.tiposVehiculo = [];
        }
        
        console.log('Tipos vehículo loaded successfully. Count:', this.tiposVehiculo.length);
      },
      error: (error: any) => {
        console.error('Error loading tipos vehículo:', error);
        this.tiposVehiculo = this.getMockTiposVehiculo();
      }
    });
  }

  loadEstaciones() {
    console.log('Loading estaciones...');
    this.estacionesService.getAll().subscribe({
      next: (response: PaginatedResponse<Estacion> | Estacion[]) => {
        // Handle both paginated and direct array responses
        if (Array.isArray(response)) {
          this.estaciones = response;
        } else if (response && response.data) {
          this.estaciones = response.data;
        } else {
          console.warn('Unexpected response format:', response);
          this.estaciones = [];
        }
        
        console.log('Estaciones loaded successfully. Count:', this.estaciones.length);
      },
      error: (error: any) => {
        console.error('Error loading estaciones:', error);
        this.estaciones = this.getMockEstaciones();
      }
    });
  }

  loadMockData() {
    console.log('Loading mock tarifas data...');
    
    // Asegurarse de que tengamos tipos de vehículo y estaciones mock
    if (this.tiposVehiculo.length === 0) {
      this.tiposVehiculo = this.getMockTiposVehiculo();
    }
    
    if (this.estaciones.length === 0) {
      this.estaciones = this.getMockEstaciones();
    }
    
    // Mock data for demonstration
    const today = new Date();
    const pastDate = new Date();
    pastDate.setDate(today.getDate() - 30);
    
    const futureDate = new Date();
    futureDate.setDate(today.getDate() + 180);
    
    this.tarifas = [
      {
        id: 1,
        tipoVehiculoId: 1,
        tipoVehiculo: this.tiposVehiculo.find(t => t.id === 1) || {id: 1, nombre: 'Automóvil', descripcion: 'Vehículo de 4 ruedas', numeroEjes: 2, categoria: 'Categoría I', tarifaBase: 1.0, esActivo: true, activo: true, fechaCreacion: new Date()},
        estacionId: 1,
        estacion: this.estaciones.find(e => e.id === 1) || {id: 1, nombre: 'Estación Norte', ubicacion: 'Norte', descripcion: 'Estación principal', activo: true, fechaCreacion: new Date()},
        monto: 1.50,
        fechaVigenciaInicio: pastDate,
        fechaVigenciaFin: futureDate,
        esVigente: true,
        activo: true,
        fechaCreacion: new Date('2024-01-15')
      },
      {
        id: 2,
        tipoVehiculoId: 2,
        tipoVehiculo: this.tiposVehiculo.find(t => t.id === 2) || {id: 2, nombre: 'Camión', descripcion: 'Vehículo pesado', numeroEjes: 3, categoria: 'Categoría II', tarifaBase: 2.0, esActivo: true, activo: true, fechaCreacion: new Date()},
        estacionId: 1,
        estacion: this.estaciones.find(e => e.id === 1) || {id: 1, nombre: 'Estación Norte', ubicacion: 'Norte', descripcion: 'Estación principal', activo: true, fechaCreacion: new Date()},
        monto: 3.00,
        fechaVigenciaInicio: pastDate,
        fechaVigenciaFin: futureDate,
        esVigente: true,
        activo: true,
        fechaCreacion: new Date('2024-01-15')
      },
      {
        id: 3,
        tipoVehiculoId: 1,
        tipoVehiculo: this.tiposVehiculo.find(t => t.id === 1) || {id: 1, nombre: 'Automóvil', descripcion: 'Vehículo de 4 ruedas', numeroEjes: 2, categoria: 'Categoría I', tarifaBase: 1.0, esActivo: true, activo: true, fechaCreacion: new Date()},
        estacionId: 2,
        estacion: this.estaciones.find(e => e.id === 2) || {id: 2, nombre: 'Estación Sur', ubicacion: 'Sur', descripcion: 'Estación secundaria', activo: true, fechaCreacion: new Date()},
        monto: 1.75,
        fechaVigenciaInicio: pastDate,
        fechaVigenciaFin: futureDate,
        esVigente: true,
        activo: true,
        fechaCreacion: new Date('2024-01-15')
      },
      {
        id: 4,
        tipoVehiculoId: 3,
        tipoVehiculo: this.tiposVehiculo.find(t => t.id === 3) || {id: 3, nombre: 'Bus', descripcion: 'Transporte público', numeroEjes: 2, categoria: 'Categoría II', tarifaBase: 1.5, esActivo: true, activo: true, fechaCreacion: new Date()},
        estacionId: 1,
        estacion: this.estaciones.find(e => e.id === 1) || {id: 1, nombre: 'Estación Norte', ubicacion: 'Norte', descripcion: 'Estación principal', activo: true, fechaCreacion: new Date()},
        monto: 2.50,
        fechaVigenciaInicio: new Date('2023-01-01'),
        fechaVigenciaFin: new Date('2023-12-31'),
        esVigente: false,
        activo: true,
        fechaCreacion: new Date('2023-01-01')
      }
    ];
    
    this.totalTarifas = this.tarifas.length;
    this.loading = false;
    console.log('Mock tarifas loaded successfully:', this.tarifas.length, 'records');
    this.filterAndPaginateTarifas();
  }

  private getMockTiposVehiculo(): TipoVehiculo[] {
    return [
      {id: 1, nombre: 'Automóvil', descripcion: 'Vehículo de 4 ruedas', numeroEjes: 2, categoria: 'Categoría I', tarifaBase: 1.0, esActivo: true, activo: true, fechaCreacion: new Date()},
      {id: 2, nombre: 'Camión', descripcion: 'Vehículo pesado', numeroEjes: 3, categoria: 'Categoría II', tarifaBase: 2.0, esActivo: true, activo: true, fechaCreacion: new Date()},
      {id: 3, nombre: 'Bus', descripcion: 'Transporte público', numeroEjes: 2, categoria: 'Categoría II', tarifaBase: 1.5, esActivo: true, activo: true, fechaCreacion: new Date()},
      {id: 4, nombre: 'Motocicleta', descripcion: 'Vehículo de 2 ruedas', numeroEjes: 1, categoria: 'Categoría I', tarifaBase: 0.5, esActivo: true, activo: true, fechaCreacion: new Date()}
    ];
  }

  private getMockEstaciones(): Estacion[] {
    return [
      {id: 1, nombre: 'Estación Norte', ubicacion: 'Norte de la ciudad', descripcion: 'Estación principal de entrada norte', activo: true, fechaCreacion: new Date()},
      {id: 2, nombre: 'Estación Sur', ubicacion: 'Sur de la ciudad', descripcion: 'Estación principal de entrada sur', activo: true, fechaCreacion: new Date()},
      {id: 3, nombre: 'Estación Este', ubicacion: 'Este de la ciudad', descripcion: 'Estación secundaria este', activo: true, fechaCreacion: new Date()}
    ];
  }

  filterAndPaginateTarifas() {
    let filteredTarifas = [...this.tarifas];

    // Apply search filter
    if (this.searchTerm) {
      const term = this.searchTerm.toLowerCase();
      filteredTarifas = filteredTarifas.filter(tarifa =>
        tarifa.tipoVehiculo?.nombre.toLowerCase().includes(term) ||
        tarifa.estacion?.nombre.toLowerCase().includes(term) ||
        tarifa.monto.toString().includes(term)
      );
    }

    // Apply tipo vehiculo filter
    if (this.selectedTipoVehiculo) {
      filteredTarifas = filteredTarifas.filter(tarifa => 
        tarifa.tipoVehiculoId.toString() === this.selectedTipoVehiculo
      );
    }

    // Apply estacion filter
    if (this.selectedEstacion) {
      filteredTarifas = filteredTarifas.filter(tarifa => 
        tarifa.estacionId?.toString() === this.selectedEstacion
      );
    }

    // Apply vigencia filter
    if (this.vigenciaFilter !== 'todas') {
      if (this.vigenciaFilter === 'vigentes') {
        filteredTarifas = filteredTarifas.filter(tarifa => tarifa.esVigente === true);
      } else if (this.vigenciaFilter === 'noVigentes') {
        filteredTarifas = filteredTarifas.filter(tarifa => tarifa.esVigente === false);
      }
    }

    // Apply sorting
    if (this.sortField) {
      filteredTarifas.sort((a, b) => {
        let aValue = this.getFieldValue(a, this.sortField);
        let bValue = this.getFieldValue(b, this.sortField);
        
        if (typeof aValue === 'string') {
          aValue = aValue.toLowerCase();
          bValue = bValue.toLowerCase();
        }
        
        if (aValue < bValue) return this.sortDirection === 'asc' ? -1 : 1;
        if (aValue > bValue) return this.sortDirection === 'asc' ? 1 : -1;
        return 0;
      });
    }

    // Update totals
    this.totalTarifas = filteredTarifas.length;
    this.totalPages = Math.ceil(this.totalTarifas / this.pageSize);

    // Apply pagination
    const startIndex = (this.currentPage - 1) * this.pageSize;
    const endIndex = startIndex + this.pageSize;
    this.pagedTarifas = filteredTarifas.slice(startIndex, endIndex);

    // Adjust current page if necessary
    if (this.currentPage > this.totalPages && this.totalPages > 0) {
      this.currentPage = this.totalPages;
      this.filterAndPaginateTarifas();
    }
  }

  private getFieldValue(obj: any, field: string): any {
    return field.split('.').reduce((o, f) => o?.[f], obj) || '';
  }

  // Event handlers
  onSearch() {
    this.currentPage = 1;
    this.filterAndPaginateTarifas();
  }

  onFilterByTipoVehiculo() {
    this.currentPage = 1;
    this.filterAndPaginateTarifas();
  }

  onFilterByEstacion() {
    this.currentPage = 1;
    this.filterAndPaginateTarifas();
  }
  
  onFilterByVigencia() {
    this.currentPage = 1;
    this.filterAndPaginateTarifas();
  }

  sort(field: string) {
    if (this.sortField === field) {
      this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
    } else {
      this.sortField = field;
      this.sortDirection = 'asc';
    }
    this.filterAndPaginateTarifas();
  }

  goToPage(page: number) {
    if (page >= 1 && page <= this.totalPages) {
      this.currentPage = page;
      this.filterAndPaginateTarifas();
    }
  }

  // CRUD operations
  onAdd() {
    console.log('onAdd() called - Opening tarifa form');
    this.selectedTarifa = null;
    this.showTarifaForm = true;
  }

  onEdit(tarifa: Tarifa) {
    this.selectedTarifa = tarifa;
    this.showTarifaForm = true;
    this.showViewDialog = false;
  }

  onView(tarifa: Tarifa) {
    this.selectedTarifa = tarifa;
    this.showViewDialog = true;
  }

  onDelete(tarifa: Tarifa) {
    this.tarifaToDelete = tarifa;
    this.showDeleteDialog = true;
  }

  onRefresh() {
    console.log('Refreshing tarifas data...');
    this.searchTerm = '';
    this.selectedTipoVehiculo = '';
    this.selectedEstacion = '';
    this.vigenciaFilter = 'todas';
    this.currentPage = 1;
    this.loading = true;
    
    // Clear current data
    this.tarifas = [];
    this.pagedTarifas = [];
    
    // Reload data from API
    this.loadTiposVehiculo();
    this.loadEstaciones();
    this.loadTarifas();
  }

  onSaveTarifa(tarifaData: Partial<Tarifa>) {
    this.isSubmittingForm = true;
    
    if (tarifaData.id) {
      // Edit existing tarifa
      this.tarifasService.update(tarifaData.id, tarifaData).subscribe({
        next: () => {
          this.loadTarifas();
          this.onCancelForm();
          this.isSubmittingForm = false;
        },
        error: (error: any) => {
          console.error('Error updating tarifa:', error);
          alert('No se pudo actualizar la tarifa. Verifique la conexión con el servidor.');
          this.isSubmittingForm = false;
        }
      });
    } else {
      // Add new tarifa
      this.tarifasService.create(tarifaData).subscribe({
        next: () => {
          this.loadTarifas();
          this.onCancelForm();
          this.isSubmittingForm = false;
        },
        error: (error: any) => {
          console.error('Error creating tarifa:', error);
          alert('No se pudo crear la tarifa. Verifique la conexión con el servidor.');
          this.isSubmittingForm = false;
        }
      });
    }
  }

  onCancelForm() {
    this.showTarifaForm = false;
    this.selectedTarifa = null;
    this.isSubmittingForm = false;
  }

  confirmDelete() {
    if (this.tarifaToDelete) {
      this.tarifasService.delete(this.tarifaToDelete.id).subscribe({
        next: () => {
          this.loadTarifas();
          this.cancelDelete();
        },
        error: (error: any) => {
          console.error('Error deleting tarifa:', error);
          alert('No se pudo eliminar la tarifa. Verifique la conexión con el servidor.');
          this.cancelDelete();
        }
      });
    }
  }

  cancelDelete() {
    this.showDeleteDialog = false;
    this.tarifaToDelete = null;
  }

  closeViewDialog() {
    this.showViewDialog = false;
    this.selectedTarifa = null;
  }

  formatDate(date: Date | string | undefined): string {
    if (!date) return 'N/A';
    
    const d = new Date(date);
    return d.toLocaleDateString('es-ES', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    });
  }

  // Utility methods
  getVigenciaClass(esVigente: boolean): string {
    return esVigente ? 'status-vigente' : 'status-no-vigente';
  }

  getMaxShown(): number {
    return Math.min(this.currentPage * this.pageSize, this.totalTarifas);
  }

  // TrackBy functions for performance
  trackByTarifaId(index: number, tarifa: Tarifa): number {
    return tarifa.id;
  }

  trackByTipoVehiculoId(index: number, tipo: TipoVehiculo): number {
    return tipo.id;
  }

  trackByEstacionId(index: number, estacion: Estacion): number {
    return estacion.id;
  }
}
